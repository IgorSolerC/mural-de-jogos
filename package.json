{
  "name": "mural-de-jogos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test mural-de-jogos",
    "test:ci": "ng test mural-de-jogos --watch=false --browsers=ChromeHeadless && node --test scripts/sw.test.mjs && npm run test:cofre",
    "build:cofre": "ng build cofre && node scripts/cofre-hashes.mjs",
    "test:cofre": "ng test cofre --watch=false --browsers=ChromeHeadless && node --test projects/cofre/regras.test.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "hash-wasm": "4.12.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.41",
    "@angular/cli": "^20.3.41",
    "@angular/compiler-cli": "^20.3.34",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.8.2"
  }
}

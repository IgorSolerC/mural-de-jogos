{
  "name": "mural-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx src/entry/node.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "npm run test:node && npm run test:workers",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "deploy": "wrangler d1 migrations apply mural --remote && wrangler deploy",
    "backup": "wrangler d1 export mural --remote --output=backup-mural.sql"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "description": "A API do Meu Mural (Cloudflare Workers + D1, portável para Node + SQLite).",
  "engines": {
    "node": ">=22.13"
  }
}

{
  // O núcleo + a entrada da Cloudflare, com os tipos do Workers. O núcleo também é conferido com os
  // tipos do Node (tsconfig.node.json): se ele usar algo que só existe num dos dois, um deles quebra.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/workers.test.ts", "test/suite.ts", "test/entry.suite.ts", "test/create.suite.ts", "test/open.suite.ts", "test/items.suite.ts", "test/manage.suite.ts", "test/harness.ts", "test/webauthn.test.ts", "test/webauthn-vetores.ts"],
  "exclude": ["src/adapters/sqlite-node.ts"]
}
